# EdgeWatch Docker Ignore File
# Optimize Docker build context by excluding unnecessary files

# Git files
.git
.gitignore
.gitattributes

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.tox/

# Documentation
docs/_build/
site/

# Local development files
.env
.env.local
.env.development
.env.test
.env.production

# Log files
*.log
logs/
*.out

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Node.js (if any frontend components)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deployment specific
deployment/ssl/
deployment/secrets/

# Data directories
data/
backups/

# Jupyter Notebooks
.ipynb_checkpoints

# Research papers and documentation
*.pdf
*.doc
*.docx

# Large media files
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.png
*.gif
*.svg

# Archive files
*.zip
*.tar.gz
*.rar

# Exclude the original DEmon project (if still present)
DEmon/
demon/
