# EdgeWatch - Development Dockerfile
# Optimized for development with hot reloading and debugging

FROM python:3.9-slim

# Set metadata
LABEL maintainer="EdgeWatch Development Team" \
      description="EdgeWatch Development Environment" \
      version="1.0.0-dev"

# Set working directory
WORKDIR /app

# Development environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    EDGEWATCH_ENV=development \
    EDGEWATCH_PORT=5000 \
    EDGEWATCH_HOST=0.0.0.0 \
    EDGEWATCH_DEBUG=true

# Install system dependencies including development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    wget \
    net-tools \
    procps \
    htop \
    iputils-ping \
    telnet \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy requirements
COPY requirements.txt .
COPY requirements-dev.txt .

# Install Python dependencies including development packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dev.txt

# Create application directories
RUN mkdir -p /app/data /app/logs /app/temp /app/tests

# Create development user
RUN useradd --create-home --shell /bin/bash --uid 1000 edgewatch && \
    chown -R edgewatch:edgewatch /app && \
    chmod -R 755 /app

# Switch to development user
USER edgewatch

# Expose ports for development services
EXPOSE 5000 5001 8080 8081 9090 9091

# Health check for development
HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:${EDGEWATCH_PORT}/health || exit 1

# Default command for development (can be overridden)
CMD ["python", "-m", "src.core.edgewatch_daemon", "--debug"]
