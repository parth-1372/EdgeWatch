# EdgeWatch Production Performance Tuning
# Optimized settings for production deployment

# Container resource limits (adjust based on available system resources)
EDGEWATCH_CPU_LIMIT=2.0
EDGEWATCH_MEMORY_LIMIT=2G
EDGEWATCH_CPU_RESERVATION=0.5
EDGEWATCH_MEMORY_RESERVATION=512M

# Database optimization settings
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=32MB
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MIN_WAL_SIZE=2GB

# Redis optimization settings
REDIS_MAXMEMORY=512MB
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_TCP_KEEPALIVE=300
REDIS_TIMEOUT=0

# EdgeWatch application settings
EDGEWATCH_WORKER_THREADS=8
EDGEWATCH_CONNECTION_POOL_SIZE=100
EDGEWATCH_REQUEST_TIMEOUT=30
EDGEWATCH_MAX_CONTENT_LENGTH=32MB
EDGEWATCH_ENABLE_COMPRESSION=true
EDGEWATCH_CACHE_TIMEOUT=3600

# Network optimization
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=2048
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_CLIENT_MAX_BODY_SIZE=32M
NGINX_GZIP_COMPRESSION=on

# Monitoring optimization
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_EVALUATION_INTERVAL=30s

# Security settings
EDGEWATCH_RATE_LIMIT_REQUESTS=10000
EDGEWATCH_RATE_LIMIT_WINDOW=3600
EDGEWATCH_API_KEY_REQUIRED=true
EDGEWATCH_CORS_ENABLED=true

# Logging optimization
LOG_LEVEL=INFO
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_ROTATION_ENABLED=true

# Health check optimization
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Backup optimization
BACKUP_ENABLED=true
BACKUP_INTERVAL=21600  # 6 hours
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Cluster optimization
GOSSIP_INTERVAL=30
GOSSIP_FANOUT=3
GOSSIP_MAX_PEERS=100
GOSSIP_TIMEOUT=10

# Container optimization
CONTAINER_RESTART_POLICY=unless-stopped
CONTAINER_ULIMIT_NOFILE=65536
CONTAINER_ULIMIT_NPROC=4096

# JVM optimization (if using Java components)
JVM_XMS=512m
JVM_XMX=1024m
JVM_XX_NEWRATIO=2
JVM_XX_MAXGCPAUSEMILLIS=200
